# Rust
/target/
**/target/
Cargo.lock.bak
*.pdb

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local
.pnpm-store/
test-results/

version-update.txt

# Tauri
app/src-tauri/target/
app/src-tauri/gen/schemas/

# Cargo.lock IS committed: every crate here builds a binary, and reproducible
# builds matter more than dependency-range flexibility.

# Env / secrets
.env
.env.*
*.token

# Editor / OS
.vscode/
.idea/
.claude/
.agents/
scratch/
transitions/
skills-lock.json
*.iml
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# SQLite & server runtime data
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
server/data/

# Mobile icon sets, regenerated by `tauri icon` if a mobile target is ever added.
app/src-tauri/icons/ios/
app/src-tauri/icons/android/

# Extension signing & server export artifacts
extension/web-ext-artifacts/
extension/.amo-upload-uuid
extension/*.zip
dist-server/

# Bundled media tool binaries (populated by build_app.bat)
app/src-tauri/resources/bin/*.exe
app/src-tauri/resources/bin/*.zip
app/src-tauri/resources/bin/*.dll
app/src-tauri/resources/bin/LICENSE
app/src-tauri/resources/bin/README.txt
app/src-tauri/resources/bin/media_tools.lock.json
!app/src-tauri/resources/bin/.gitkeep


# Local documentation, retired server sources, and design workspace.
/docs/
/server/
/.impeccable/

# Keep only the root project overview and contributor instructions.
/*.md
!/README.md
!/AGENTS.md
!/RELEASING.md

# Local root launchers; maintained build commands live in scripts/bat/ and are tracked.
/*.bat

# Build, release, signing and changelog tooling is tracked in scripts/. Only
# personal helpers stay local.
/scripts/clean_cache.ps1
/scripts/measure_window_drag.ps1
/scripts/package_homelab_server.ps1
/scripts/bat/clean_cache.bat
/scripts/bat/package_homelab_server.bat
/scripts/tests/clean_cache.test.ps1
/scripts/tests/update_homelab_server.*

# Generated graphify knowledge graph and cache.
/graphify-out/
