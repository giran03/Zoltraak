# Normalize to LF in the repo; check out native. Without this, a cross-platform
# project accumulates spurious whole-file diffs whenever Windows and Linux
# contributors touch the same file.
* text=auto eol=lf

# Windows-only tooling that requires CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff, never convert.
*.png binary
*.ico binary
*.icns binary
*.woff2 binary

# Generated lockfiles: keep them out of review diffs.
package-lock.json linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff

# Vendored third-party source (see engine/vendor/libsqlite3-sys/VENDORED.md):
# keep it out of review diffs and language stats.
engine/vendor/** linguist-vendored=true
engine/vendor/**/sqlite3/sqlite3.c -diff
